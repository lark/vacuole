<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vacuole.daemon</string>
    <!-- There is no bundle context under /Library/LaunchDaemons, so BundleProgram does not work; an absolute path is required. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/vacuole.app/Contents/MacOS/vacuoled</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>com.vacuole.daemon</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/tmp/vacuoled.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vacuoled.err.log</string>
</dict>
</plist>